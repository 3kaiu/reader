{
  "frontend": {
    "edgeOnlyPrefixes": [
      "/api/analytics",
      "/api/agent",
      "/api/preferences",
      "/api/content/upload",
      "/api/backup",
      "/api/metrics/client",
      "/progress/",
      "/decode/",
      "/auth/"
    ],
    "directEligiblePrefixes": [
      "/api/search",
      "/api/sources",
      "/api/source-packages",
      "/api/source-builder",
      "/api/engine",
      "/api/fetch",
      "/api/book",
      "/api/chapters",
      "/api/content",
      "/api/batch/content",
      "/api/bookshelf",
      "/api/groups",
      "/api/replace_rules",
      "/api/discovery",
      "/api/ai/",
      "/ws/"
    ]
  },
  "worker": {
    "userServicePrefixes": [
      "/api/health",
      "/api/analytics/",
      "/api/agent/",
      "/api/preferences",
      "/api/content/upload",
      "/api/backup",
      "/api/metrics/client"
    ],
    "experimentalRoutes": [
      "/api/search",
      "/api/book",
      "/api/chapters",
      "/api/content",
      "/api/source-builder/*",
      "/api/source-packages/*",
