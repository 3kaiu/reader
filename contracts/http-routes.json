      "/api/source-builder/refine",
      "/api/fetch/session/import",
      "/api/fetch/session/{id}",
      "/api/fetch/html",
      "/api/engine/run-by-package",
      "/api/search",
      "/api/search/stream",
      "/ws/search",
      "/api/book",
      "/api/chapters",
      "/api/content",
      "/api/batch/content",
      "/api/bookshelf",
      "/api/bookshelf/{id}",
      "/api/groups",
      "/api/groups/{id}",
      "/api/replace_rules",
      "/api/replace_rules/{id}",
      "/api/discovery",
      "/api/ai/mappings",
      "/api/ai/mappings/{id}",
      "/api/ai/history",
      "/api/voice/metadata",
      "/api/voice/metadata/{id}",
      "/api/voice/config/{key}"
