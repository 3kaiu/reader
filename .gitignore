node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
out/
target/
*.so

# IDE
.idea/
.vscode/
*.iml

# Data & Logs
data/
logs/
cache/
*.log

# Test artifacts
coverage/
test-results/
.nyc_output/

# System files
.DS_Store
Thumbs.db
*~
*.tmp
.tmp-*
*.bak

# Docker
docker-compose.override.yml

# Lock files (use bun.lock for frontend)
/web/package-lock.json
yarn.lock
