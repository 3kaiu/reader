    "nextTocUrl": "$..count\n<js>\na=String(result[0]);\nb= Math.floor(parseFloat(a.replace(/\\s/,''))/100);\nb=b+1\nlist=[];\nfor(i=0;i<=b;i++){\n\tlist.push(baseUrl.replace(/offset=0/,'offset='+100*i))\n\t}list\n</js>"
  },
  "ruleContent": {
