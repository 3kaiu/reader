# Cloudflare Progress Sync Worker URL
VITE_PROGRESS_SYNC_URL=https://nexus-reader-edge.your-subdomain.workers.dev

# Cloudflare Backup Worker URL (for bookshelf backup)
VITE_BACKUP_URL=https://nexus-reader-edge.your-subdomain.workers.dev

# Cloudflare Decoder Worker URL (for novel decryption)
VITE_DECODER_URL=https://nexus-reader-edge.your-subdomain.workers.dev

# Nexus Lite Backend API URL (Hugging Face Space)
VITE_NEXUS_LITE_DIRECT_URL=https://huggingface.co/spaces/YOUR_USERNAME/YOUR_SPACE_NAME

# Nexus Lite API Key (optional)
VITE_NEXUS_LITE_API_KEY=your-api-key-here

# Hugging Face Space URL (auto-generated)
HF_SPACE_URL=https://huggingface.co/spaces/YOUR_USERNAME/YOUR_SPACE_NAME

# Cloudflare Workers API URL (edge connection)
VITE_API_URL=/api

# Hugging Face API Key (for AI features)
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Authentication (loaded from GitHub Secrets)
AUTH_SECRET=your-auth-secret-here
OAUTH_GITHUB_CLIENT_ID=your-github-client-id-here
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Cloudflare (loaded from GitHub Secrets)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# Debug mode (uncomment to enable)
# DEBUG=true
