{
  "$v": 2,
  "id": "hetushu",
  "name": "和图书",
  "url": "https://www.hetushu.com",
  "search": {
    "path": "/search/?keyword={q}",
    "list": "ul.book_list li",
    "item": {
      "name": "h3 a",
      "author": ".author",
      "url": "h3 a@href",
      "cover": "img@src",
      "intro": ".intro"
    }
  },
  "book": {
    "name": "h2",
    "author": "a[href*='/author/']",
    "intro": ".intro",
    "cover": ".book_info img@src"
  },
  "toc": {
    "list": "dl#dir dd a",
    "item": {
      "name": "text",
      "url": "href"
    }
  },
  "content": {
    "body": "#content",
    "filter": ["script", "style", "div[id*='preact']", ".ad"],
    "visible_only": true,
    "script": "(() => { const content = document.getElementById('content'); if (!content) return ''; const visibleElements = Array.from(content.children).filter(el => { const style = window.getComputedStyle(el); return style.display !== 'none' && style.visibility !== 'hidden'; }); const noiseTags = ['acronym', 'bdo', 'big', 'cite', 'code', 'dfn', 'kbd', 'q', 's', 'samp', 'strike', 'tt', 'u', 'var']; const cleanedParagraphs = visibleElements.map(el => { const clone = el.cloneNode(true); noiseTags.forEach(tag => { Array.from(clone.getElementsByTagName(tag)).forEach(n => n.remove()); }); return clone.innerText.trim(); }).filter(text => text.length > 0); return cleanedParagraphs.join('\\n\\n'); })()"
  },
  "protection": "L6",
  "anti_crawl_level": 6
}
