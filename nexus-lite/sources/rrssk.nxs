{
  "$v": 2,
  "id": "rrssk",
  "name": "可乐小说",
  "url": "https://www.rrssk.com",
  "search": {
    "path": "https://html.duckduckgo.com/html/?q=site%3Arrssk.com+{q}",
    "method": "GET",
    "list": ".result",
    "item": {
      "name": ".result__title",
      "url": ".result__url@href",
      "intro": ".result__snippet"
    }
  },
  "book": {
    "name": "h1",
    "author": "p:contains('作者')",
    "intro": "div.des",
    "cover": "img[src*='cover']@src",
    "toc": "a[href*='#']@href"
  },
  "toc": {
    "list": "ul li a",
    "item": {
      "name": "text",
      "url": "href"
    }
  },
  "content": {
    "body": "div.content, div.con",
    "filter": ["script", "style", ".ad"]
  }
}
