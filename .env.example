# =============================================================================
# Nexus Reader - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real secrets to version control

# Application Configuration
NODE_ENV=development
APP_NAME=nexus-reader
APP_VERSION=2.0.0
APP_DESCRIPTION="Modern Personal Cloud Reading Platform"

# Domain Configuration
DOMAIN=localhost:3000
API_DOMAIN=localhost:8080
CDN_DOMAIN=localhost:8080
STATIC_DOMAIN=localhost:3000

# API Configuration
API_BASE_URL=http://localhost:8080
CDN_BASE_URL=http://localhost:8080
STATIC_BASE_URL=http://localhost:3000

# Cloudflare Configuration (Optional - for production)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# KV Namespace IDs (Optional - for production)
KV_NAMESPACE_ID=your_kv_namespace_id
KV_CACHE_NAMESPACE_ID=your_cache_namespace_id
KV_ANALYTICS_NAMESPACE_ID=your_analytics_namespace_id

# Database Configuration
DATABASE_URL=sqlite://./data/nexus.db
REDIS_URL=redis://localhost:6379

# Security Configuration
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_here_32_characters
WEBHOOK_SECRET=your_webhook_secret_here

# AI Service Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
CLOUDFLARE_AI_API_TOKEN=your_cf_ai_token_here

# Monitoring and Analytics (Optional)
ANALYTICS_API_KEY=your_analytics_key_here
ERROR_REPORTING_DSN=your_sentry_dsn_here
SLACK_WEBHOOK_URL=your_slack_webhook_here
ALERT_EMAIL=admin@example.com

# Performance Configuration
CACHE_TTL=3600
CDN_CACHE_TTL=86400
STATIC_CACHE_TTL=31536000

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# Free Tier Limits (for production optimization)
GITHUB_ACTIONS_MINUTES_LIMIT=2000
CLOUDFLARE_WORKER_REQUESTS_LIMIT=100000
CLOUDFLARE_KV_STORAGE_LIMIT=1073741824
CLOUDFLARE_IMAGES_TRANSFORMS_LIMIT=100000
CLOUDFLARE_AI_REQUESTS_LIMIT=10000

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
ENABLE_HEALTH_CHECKS=true

# Development Configuration
DEBUG_MODE=true
VERBOSE_LOGGING=true
ENABLE_DEV_TOOLS=true
LOG_LEVEL=debug
LOG_FORMAT=pretty

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

# PWA Configuration
PWA_NAME="Nexus Reader"
PWA_SHORT_NAME="NexusReader"
PWA_DESCRIPTION="Modern Personal Cloud Reading Platform"
PWA_THEME_COLOR="#667eea"
PWA_BACKGROUND_COLOR="#ffffff"

# =============================================================================
# Development Notes:
# 1. Generate secure random values for JWT_SECRET and ENCRYPTION_KEY
# 2. Use environment-specific values for different deployment stages
# 3. Never commit real API keys or secrets to version control
# 4. Use a secret management service in production
# =============================================================================