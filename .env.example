# Nexus Reader — Docker Compose environment variables
# Copy to .env and fill in your values.

# Your GitHub username (lowercase) — must match GHCR image owner
GITHUB_USER=your-github-user-lowercase

# Port the frontend nginx listens on
NEXUS_PORT=8080

# Log level for the API server
RUST_LOG=info

# Log level for the bypass service
LOG_LEVEL=INFO