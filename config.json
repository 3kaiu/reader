{
  "app": {
    "name": "Nexus Reader",
    "version": "1.0.0",
    "environment": "cloudflare",
    "description": "Personal AI-powered reading app on Cloudflare Free Tier"
  },
  "cloudflare": {
    "pages": {
      "url": "https://nexus-reader.pages.dev",
      "project": "nexus-reader",
      "region": "global"
    },
    "workers": {
      "url": "https://api.nexus-reader.pages.dev",
      "script": "nexus-reader-edge",
      "routes": ["/api/*"]
    },
    "kv": {
      "enabled": true,
      "namespaces": {
        "user_cache": "user_cache_kv",
        "content_cache": "content_cache_kv",
        "recommendations": "recommendation_kv",
        "analytics": "analytics_kv"
      }
    },
    "analytics": {
      "enabled": true,
      "dataset": "nexus_usage_analytics"
    }
  },
  "huggingface": {
    "spaces": {
      "cf_bypass": "cf-bypass-service",
      "enabled": false
    }
  },
  "features": {
    "analytics": true,
    "recommendations": true,
    "offline": true,
    "sync": true,
    "ai": false,
    "voice": false
  },
  "optimization": {
    "autoTune": true,
    "monitoring": true,
    "caching": true,
    "compression": true,
    "cdn": true,
    "edge": true
  },
  "performance": {
    "cache": {
      "ttl": 3600,
      "maxSize": "100MB"
    },
    "imageQuality": "high",
    "lazyLoading": true,
    "prefetch": true
  },
  "privacy": {
    "analytics": true,
    "personalization": true,
    "dataSharing": false,
    "localStorage": true
  }
}