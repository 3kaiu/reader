# =============================================================================
# CF Bypass Service - Phase 2 Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real secrets to version control

# =============================================================================
# Basic Configuration
# =============================================================================
CF_API_KEY=your_api_key_here
LOG_LEVEL=INFO

# =============================================================================
# Phase 2 Feature Flags
# =============================================================================
# Enable/disable Phase 2 optimizations
SESSION_POOL_ENABLED=true
CONNECTION_POOL_ENABLED=true
ADAPTIVE_RETRY_ENABLED=true
MEMORY_OPTIMIZATION_ENABLED=true
HEALTH_MONITORING_ENABLED=true

# =============================================================================
# Session Pool Configuration
# =============================================================================
# Number of pre-warmed sessions per domain (1-20)
# Recommended: dev=3, prod=5, high-traffic=10
SESSION_POOL_SIZE=5

# Maximum age of sessions before considered stale (hours, 1-168)
# Recommended: 24 (1 day)
SESSION_POOL_MAX_AGE_HOURS=24

# Trigger replenishment when pool drops below this ratio (0.0-1.0)
# Recommended: 0.5 (50%)
SESSION_POOL_REPLENISH_THRESHOLD=0.5

# Interval for background replenishment checks (minutes, 1-60)
# Recommended: 5 minutes
SESSION_POOL_REPLENISH_INTERVAL_MINUTES=5

# =============================================================================
# Connection Pool Configuration
# =============================================================================
# Number of connection pools to cache (10-50)
# Recommended: dev=10, prod=20, high-traffic=30
# WARNING: Values <10 may cause performance degradation
POOL_CONNECTIONS=20

# Maximum connections per pool (20-200)
# Recommended: dev=20, prod=50, high-traffic=100
# WARNING: Should be at least 2x POOL_CONNECTIONS
POOL_MAXSIZE=50

# Maximum retries per request (0-10)
# Recommended: 3
# WARNING: Values >5 may cause excessive delays
POOL_MAX_RETRIES=3

# Backoff multiplier for retries (0.1-2.0)
# Recommended: 0.3-1.0
# WARNING: Values <0.1 may cause retry storms
POOL_BACKOFF_FACTOR=0.3

# =============================================================================
# Adaptive Retry Configuration
# =============================================================================
# Max retries for high reliability domains (>90% success, 1-5)
# Recommended: 2
RETRY_HIGH_RELIABILITY_MAX=2

# Max retries for medium reliability domains (70-90% success, 2-7)
# Recommended: 3
RETRY_MEDIUM_RELIABILITY_MAX=3

# Max retries for low reliability domains (<70% success, 3-10)
# Recommended: 5
RETRY_LOW_RELIABILITY_MAX=5

# Backoff factor for high reliability domains (0.5-2.0)
# Recommended: 1.0
RETRY_HIGH_BACKOFF=1.0

# Backoff factor for medium reliability domains (1.0-3.0)
# Recommended: 1.5
RETRY_MEDIUM_BACKOFF=1.5

# Backoff factor for low reliability domains (1.5-5.0)
# Recommended: 2.0
RETRY_LOW_BACKOFF=2.0

# Threshold for high reliability tier (0.8-0.95)
# Recommended: 0.9 (90%)
RETRY_SUCCESS_RATE_HIGH=0.9

# Threshold for medium reliability tier (0.6-0.8)
# Recommended: 0.7 (70%)
RETRY_SUCCESS_RATE_MEDIUM=0.7

# =============================================================================
# Memory Management Configuration
# =============================================================================
# Response size threshold for streaming mode (MB, 1-100)
# Recommended: dev=5, prod=10, high-memory=20
STREAMING_THRESHOLD_MB=10

# Timeout for idle session cleanup (hours, 0.5-24)
# Recommended: dev=0.5, prod=1, low-traffic=2
IDLE_SESSION_TIMEOUT_HOURS=1

# Maximum number of cache entries (1000-100000)
# Recommended: dev=1000, prod=10000, high-traffic=50000
CACHE_SIZE_LIMIT=10000

# Memory usage threshold for aggressive cleanup (0.7-0.9)
# Recommended: 0.8 (80%)
AGGRESSIVE_CLEANUP_THRESHOLD=0.8

# Interval for periodic cleanup checks (minutes, 1-60)
# Recommended: 5 minutes
CLEANUP_INTERVAL_MINUTES=5

# =============================================================================
# Health Monitoring Configuration
# =============================================================================
# Error rate threshold for marking domain as degraded (0.3-0.7)
# Recommended: 0.5 (50%)
DEGRADATION_ERROR_THRESHOLD=0.5

# Response time multiplier for slow response detection (1.5-5.0)
# Recommended: 2.0 (200% increase)
SLOW_RESPONSE_MULTIPLIER=2.0

# Interval for health check monitoring (minutes, 1-60)
# Recommended: 5 minutes
HEALTH_CHECK_INTERVAL_MINUTES=5

# =============================================================================
# Configuration Presets
# =============================================================================
# Uncomment one of the following presets or customize above

# --- Development Preset ---
# SESSION_POOL_SIZE=3
# POOL_CONNECTIONS=10
# POOL_MAXSIZE=20
# STREAMING_THRESHOLD_MB=5
# CACHE_SIZE_LIMIT=1000
# IDLE_SESSION_TIMEOUT_HOURS=0.5

# --- Production Preset (Default) ---
# SESSION_POOL_SIZE=5
# POOL_CONNECTIONS=20
# POOL_MAXSIZE=50
# STREAMING_THRESHOLD_MB=10
# CACHE_SIZE_LIMIT=10000
# IDLE_SESSION_TIMEOUT_HOURS=1

# --- High-Traffic Preset ---
# SESSION_POOL_SIZE=10
# POOL_CONNECTIONS=30
# POOL_MAXSIZE=100
# STREAMING_THRESHOLD_MB=10
# CACHE_SIZE_LIMIT=50000
# IDLE_SESSION_TIMEOUT_HOURS=0.5
# AGGRESSIVE_CLEANUP_THRESHOLD=0.75

# --- Low-Resource Preset ---
# SESSION_POOL_SIZE=2
# POOL_CONNECTIONS=10
# POOL_MAXSIZE=20
# STREAMING_THRESHOLD_MB=5
# CACHE_SIZE_LIMIT=1000
# IDLE_SESSION_TIMEOUT_HOURS=0.5
# AGGRESSIVE_CLEANUP_THRESHOLD=0.7

# =============================================================================
# Notes:
# 1. All Phase 2 features are enabled by default for maximum performance
# 2. Use production preset values for most deployments
# 3. Adjust based on your traffic patterns and resource constraints
# 4. Monitor metrics via /stats endpoint and adjust as needed
# 5. See ENVIRONMENT_VARIABLES.md for detailed documentation
# =============================================================================
