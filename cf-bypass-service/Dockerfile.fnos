# =============================================================================
# 飞牛OS优化的CF Bypass服务Dockerfile - 多架构支持
# =============================================================================

# -----------------------------------------------------------------------------
# 阶段1: 依赖构建 - 多架构优化
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM python:3.11-slim AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

# 安装构建依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libffi-dev \
    libcurl4-openssl-dev \
    python3-dev \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装uv - 超快的Python包管理器
RUN pip install --no-cache-dir uv

# 复制依赖文件
COPY pyproject.toml uv.lock ./

# 根据架构优化安装
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-$TARGETPLATFORM \
    uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        uv pip install --no-cache --compile-bytecode -e .; \
    else \
        uv pip install --no-cache -e .; \
    fi

# -----------------------------------------------------------------------------
# 阶段2: 运行时镜像 - 飞牛OS优化
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ARG TARGETPLATFORM

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# 创建飞牛OS兼容的用户
RUN groupadd -g 1000 fnos && \
    useradd -u 1000 -g fnos -s /bin/bash -d /home/fnos -m fnos

WORKDIR /app

# 复制虚拟环境
COPY --from=builder /opt/venv /opt/venv

# 复制应用代码
COPY --chown=fnos:fnos \
    app.py \
    cloudscraper_wrapper.py \
    config_manager.py \
    config_validator.py \
    enhanced_logger.py \
    error_handler.py \
    ./

# 创建数据目录
RUN mkdir -p data && chown -R fnos:fnos /app

# 切换到fnos用户
USER fnos

# 飞牛OS优化的环境变量
ENV PATH="/opt/venv/bin:$PATH" \
    HOST=0.0.0.0 \
    PORT=8000 \
    JS_INTERPRETER=js2py \
    REQUEST_TIMEOUT=90 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONOPTIMIZE=1 \
    FNOS_OPTIMIZED=true

EXPOSE 8000

# 飞牛OS友好的健康检查
HEALTHCHECK --interval=45s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 添加架构信息到启动日志
RUN echo "#!/bin/bash" > /app/start.sh && \
    echo "echo 'Starting CF Bypass Service on $TARGETPLATFORM for FnOS...'" >> /app/start.sh && \
    echo "exec uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1" >> /app/start.sh && \
    chmod +x /app/start.sh

ENTRYPOINT ["/app/start.sh"]