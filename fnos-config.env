# =============================================================================
# Nexus Reader 飞牛OS环境配置
# 端侧AI优化版本
# =============================================================================

# 基础配置
TZ=Asia/Shanghai
DATA_DIR=./data

# GitHub容器注册表配置
GITHUB_OWNER=3kaiu
IMAGE_TAG=latest

# 服务端口配置
NEXUS_PORT=8080
CF_BYPASS_PORT=8001

# 资源限制配置（根据飞牛OS硬件调整）
NEXUS_MEMORY_LIMIT=1G
NEXUS_CPU_LIMIT=2.0
REDIS_MEMORY=128M

# 日志级别
RUST_LOG=info
PYTHONUNBUFFERED=1

# Redis配置
REDIS_URL=redis://redis:6379

# 网络配置
HOST=0.0.0.0

# 飞牛OS特定配置
FNOS_OPTIMIZED=true
ARCHITECTURE=auto

# AI功能配置（端侧AI优化）
AI_ENABLED=true
AI_CACHE_SIZE=2G
AI_PRELOAD_MODELS=false

# TTS功能配置
TTS_ENABLED=true
TTS_CACHE_SIZE=512M

# 网络配置
NETWORK_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10

# 安全配置
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# 备份配置（飞牛OS集成）
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7