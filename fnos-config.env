# =============================================================================
# 飞牛OS环境配置文件 - 简化版本
# =============================================================================

# 基础配置
TZ=Asia/Shanghai
RUST_LOG=info
PYTHONUNBUFFERED=1

# 应用端口
NEXUS_PORT=8080
CF_BYPASS_PORT=8000

# Redis配置
REDIS_URL=redis://redis:6379

# 网络配置
HOST=0.0.0.0

# 数据目录
DATA_DIR=./data

# 日志配置
LOG_LEVEL=info

# 缓存配置
CACHE_SIZE=128MB

# 架构优化 (auto/amd64/arm64)
ARCHITECTURE=auto

# 飞牛OS优化开关
FNOS_OPTIMIZED=true