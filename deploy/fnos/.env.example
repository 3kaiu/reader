# Copy to .env next to docker-compose.yml and adjust.

# GitHub username or org (lowercase) — must match GHCR image: ghcr.io/<this>/nexus-server
GITHUB_USER=your-github-user-lowercase

# Host port -> container 7860 (matches the Nexus API Dockerfile in api/)
NEXUS_PORT=4310

RUST_LOG=info

# Watchtower poll seconds (default 3600 = 1h)
WATCHTOWER_POLL_INTERVAL=3600

# Optional: GitHub repo secrets for deploy-personal.yml smoke after Pages deploy:
# DEPLOY_SMOKE_PAGES_URL — set to your preferred Pages URL (for example https://nexus.pages.dev); the workflow still falls back to the legacy project URL if unset
# DEPLOY_SMOKE_API_HEALTH_URL — e.g. https://<your-tunnel>/api/health

# Only if GHCR package is private: PAT with read:packages
# WATCHTOWER_REPO_USER=your-github-user
# WATCHTOWER_REPO_PASS=ghp_xxxx
