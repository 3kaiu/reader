# =============================================================================
# 飞牛OS优化的Dockerfile - 使用Bun替代pnpm，支持AMD64/ARM64
# =============================================================================

# -----------------------------------------------------------------------------
# 阶段1: 前端构建 - 使用Bun
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM oven/bun:1.1-alpine AS frontend-builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

# 安装构建工具
RUN apk add --no-cache brotli gzip python3 make g++

# 复制依赖文件
COPY nexus-reader/package.json nexus-reader/bun.lock ./

# 使用Bun安装依赖 - 比pnpm快很多
RUN --mount=type=cache,target=/root/.bun/install/cache,id=bun-cache-$TARGETPLATFORM \
    bun install --frozen-lockfile

# 复制源代码
COPY nexus-reader/ ./

# 使用Bun构建前端 - 根据架构调整内存
RUN --mount=type=cache,target=./.rsbuild,id=rsbuild-cache-$TARGETPLATFORM \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        NODE_OPTIONS="--max-old-space-size=1536" bun run build; \
    else \
        NODE_OPTIONS="--max-old-space-size=2048" bun run build; \
    fi

# 预压缩静态资源
RUN find dist -type f \( -name "*.js" -o -name "*.css" -o -name "*.html" -o -name "*.svg" -o -name "*.json" \) \
    -print0 | xargs -0 -P$(nproc) -I{} sh -c 'brotli -9 "$1" && gzip -9 -k "$1"' _ {}

# -----------------------------------------------------------------------------
# 阶段2: Rust构建 - 使用1.92版本支持Cargo.lock v4
# -----------------------------------------------------------------------------
FROM rust:1.92-slim AS rust-builder

ARG TARGETPLATFORM

WORKDIR /app

# 安装基本构建工具
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 复制Rust项目
COPY nexus-lite/ .

# 简化构建 - 只构建当前平台，使用更新的Rust版本
RUN cargo build --release --bin nexus-server

# 复制二进制文件
RUN cp target/release/nexus-server /app/nexus-server

# -----------------------------------------------------------------------------
# 阶段3: 运行时 - 飞牛OS优化
# -----------------------------------------------------------------------------
FROM debian:12-slim AS runtime

ARG TARGETPLATFORM

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# 创建飞牛OS兼容的用户
RUN groupadd -g 1000 fnos && \
    useradd -u 1000 -g fnos -s /bin/bash -d /home/fnos -m fnos

WORKDIR /app

# 复制构建产物
COPY --from=rust-builder /app/nexus-server ./nexus-server
COPY --from=frontend-builder /app/dist ./static
COPY nexus-lite/sources ./sources

# 创建数据目录
RUN mkdir -p data cache logs && \
    chown -R fnos:fnos /app

# 切换到fnos用户
USER fnos

# 飞牛OS优化的环境变量
ENV RUST_LOG=info \
    HOST=0.0.0.0 \
    PORT=8080 \
    STATIC_DIR=/app/static \
    TZ=Asia/Shanghai \
    RUST_BACKTRACE=0 \
    FNOS_OPTIMIZED=true

EXPOSE 8080

# 飞牛OS友好的健康检查
HEALTHCHECK --interval=45s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# 添加架构信息到启动日志
RUN echo "#!/bin/bash" > /app/start.sh && \
    echo "echo 'Starting Nexus Reader (Bun-built) on $TARGETPLATFORM for FnOS...'" >> /app/start.sh && \
    echo "exec ./nexus-server \"\$@\"" >> /app/start.sh && \
    chmod +x /app/start.sh

ENTRYPOINT ["/app/start.sh"]