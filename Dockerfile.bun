# =============================================================================
# Nexus Reader API Server - 纯后端镜像
# 前端由 Cloudflare Pages 提供，此镜像只包含 API 服务
# =============================================================================

FROM debian:12-slim

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# 创建用户
RUN groupadd -g 1000 fnos && \
    useradd -u 1000 -g fnos -s /bin/bash -d /home/fnos -m fnos

WORKDIR /app

# 复制预构建的 Rust 二进制（由 GitHub Actions 提供）
COPY nexus-lite/target/release/nexus-server ./nexus-server
COPY nexus-lite/sources ./sources

# 设置权限
RUN chmod +x ./nexus-server && \
    mkdir -p data cache logs && \
    chown -R fnos:fnos /app

USER fnos

# 环境变量 - API-only 模式
ENV RUST_LOG=info \
    HOST=0.0.0.0 \
    PORT=8080 \
    TZ=Asia/Shanghai \
    API_ONLY=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

CMD ["./nexus-server"]
