# =============================================================================
# 飞牛OS优化的Dockerfile - 使用Bun替代pnpm，支持AMD64/ARM64
# =============================================================================

# -----------------------------------------------------------------------------
# 阶段1: 前端构建 - 使用Bun
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM oven/bun:1.1-alpine AS frontend-builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

# 安装构建工具
RUN apk add --no-cache brotli gzip python3 make g++

# 复制依赖文件
COPY nexus-reader/package.json nexus-reader/bun.lockb ./

# 使用Bun安装依赖 - 比pnpm快很多
RUN --mount=type=cache,target=/root/.bun/install/cache,id=bun-cache-$TARGETPLATFORM \
    bun install --frozen-lockfile

# 复制源代码
COPY nexus-reader/ ./

# 使用Bun构建前端 - 根据架构调整内存
RUN --mount=type=cache,target=./.rsbuild,id=rsbuild-cache-$TARGETPLATFORM \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        NODE_OPTIONS="--max-old-space-size=1536" bun run build; \
    else \
        NODE_OPTIONS="--max-old-space-size=2048" bun run build; \
    fi

# 预压缩静态资源
RUN find dist -type f \( -name "*.js" -o -name "*.css" -o -name "*.html" -o -name "*.svg" -o -name "*.json" \) \
    -print0 | xargs -0 -P$(nproc) -I{} sh -c 'brotli -9 "$1" && gzip -9 -k "$1"' _ {}

# -----------------------------------------------------------------------------
# 阶段2: Rust构建 - 多架构优化
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM lukemathwalker/cargo-chef:latest-rust-1.75 AS chef

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

# 安装交叉编译工具
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    perl \
    && rm -rf /var/lib/apt/lists/*

# 根据目标平台安装工具链
RUN case "$TARGETPLATFORM" in \
    "linux/amd64") \
        rustup target add x86_64-unknown-linux-gnu ;; \
    "linux/arm64") \
        apt-get update && apt-get install -y gcc-aarch64-linux-gnu && \
        rustup target add aarch64-unknown-linux-gnu ;; \
    esac

FROM chef AS planner
COPY nexus-lite/ .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS rust-builder

ARG TARGETPLATFORM

# 复制依赖配方
COPY --from=planner /app/recipe.json recipe.json

# 设置交叉编译环境
ENV PKG_CONFIG_ALLOW_CROSS=1
RUN case "$TARGETPLATFORM" in \
    "linux/amd64") \
        export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc && \
        export CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc && \
        export TARGET=x86_64-unknown-linux-gnu ;; \
    "linux/arm64") \
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc && \
        export CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc && \
        export TARGET=aarch64-unknown-linux-gnu ;; \
    esac && \
    echo "TARGET=$TARGET" > /tmp/target

# 构建依赖
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-$TARGETPLATFORM \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-$TARGETPLATFORM \
    --mount=type=cache,target=/app/target,id=cargo-target-$TARGETPLATFORM \
    . /tmp/target && \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        RUSTFLAGS="-C target-feature=+crt-static" cargo chef cook --release --target $TARGET --recipe-path recipe.json; \
    else \
        RUSTFLAGS="-C target-feature=+crt-static -C codegen-units=1 -C lto=fat" cargo chef cook --release --target $TARGET --recipe-path recipe.json; \
    fi

# 复制源代码并构建
COPY nexus-lite/ .
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-$TARGETPLATFORM \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-$TARGETPLATFORM \
    --mount=type=cache,target=/app/target,id=cargo-target-$TARGETPLATFORM \
    . /tmp/target && \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        RUSTFLAGS="-C target-feature=+crt-static" cargo build --release --target $TARGET --bin nexus-server; \
    else \
        RUSTFLAGS="-C target-feature=+crt-static -C codegen-units=1 -C lto=fat" cargo build --release --target $TARGET --bin nexus-server; \
    fi && \
    cp target/$TARGET/release/nexus-server /app/nexus-server

# 压缩二进制文件（仅AMD64）
RUN if [ "$TARGETPLATFORM" = "linux/amd64" ] && command -v upx >/dev/null 2>&1; then \
        upx --best /app/nexus-server; \
    fi

# -----------------------------------------------------------------------------
# 阶段3: 运行时 - 飞牛OS优化
# -----------------------------------------------------------------------------
FROM debian:12-slim AS runtime

ARG TARGETPLATFORM

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# 创建飞牛OS兼容的用户
RUN groupadd -g 1000 fnos && \
    useradd -u 1000 -g fnos -s /bin/bash -d /home/fnos -m fnos

WORKDIR /app

# 复制构建产物
COPY --from=rust-builder /app/nexus-server ./nexus-server
COPY --from=frontend-builder /app/dist ./static
COPY nexus-lite/sources ./sources

# 创建数据目录
RUN mkdir -p data cache logs && \
    chown -R fnos:fnos /app

# 切换到fnos用户
USER fnos

# 飞牛OS优化的环境变量
ENV RUST_LOG=info \
    HOST=0.0.0.0 \
    PORT=8080 \
    STATIC_DIR=/app/static \
    TZ=Asia/Shanghai \
    RUST_BACKTRACE=0 \
    FNOS_OPTIMIZED=true

EXPOSE 8080

# 飞牛OS友好的健康检查
HEALTHCHECK --interval=45s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# 添加架构信息到启动日志
RUN echo "#!/bin/bash" > /app/start.sh && \
    echo "echo 'Starting Nexus Reader (Bun-built) on $TARGETPLATFORM for FnOS...'" >> /app/start.sh && \
    echo "exec ./nexus-server \"\$@\"" >> /app/start.sh && \
    chmod +x /app/start.sh

ENTRYPOINT ["/app/start.sh"]