{
  "name": "nexus-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production rsbuild build",
    "build:analyze": "ANALYZE=true NODE_ENV=production rsbuild build",
    "dev": "rsbuild dev --open",
    "preview": "rsbuild preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:properties": "node --test tests/properties/*.test.js",
    "test:coverage": "vitest --run --coverage",
    "clean": "rm -rf dist node_modules/.cache",
    "size-check": "bash analyze-performance.sh build",
    "debug-ai": "bash debug-ai-services.sh",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "node scripts/run-type-check.mjs",
    "contracts:generate": "node ../scripts/generate-http-route-constants.mjs",
    "contracts:validate": "node ../scripts/validate-contracts.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/vue-virtual": "^3.13.13",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "idb": "^8.0.3",
    "lucide-vue-next": "^0.564.0",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.25",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@rsbuild/core": "^1.7.2",
    "@rsbuild/plugin-vue": "^1.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "fast-check": "^4.5.3",
    "gh-pages": "^6.2.0",
    "glob": "^13.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.3.1",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12",
    "vitest": "^4.0.16",
    "webpack-bundle-analyzer": "^5.1.1"
  },
  "overrides": {
    "defu": "^6.1.6",
    "picomatch": "^4.0.4",
    "tar": "^7.5.11",
    "yaml": "^2.8.3"
  }
}
