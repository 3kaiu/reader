# --- Default stack: Cloudflare edge + nexus-server on NAS (GHCR) ---
# Point the reader at your Worker (or same-origin /api). Point direct calls at your Tunnel / NAS URL.

VITE_API_URL=/api
VITE_NEXUS_LITE_DIRECT_URL=https://api.example.com
VITE_NEXUS_LITE_API_KEY=

# Legacy worker name still works; for the unified brand prefer your new Nexus edge hostname.
VITE_PROGRESS_SYNC_URL=https://nexus-edge.your-account.workers.dev
VITE_BACKUP_URL=https://nexus-edge.your-account.workers.dev
VITE_DECODER_URL=https://nexus-edge.your-account.workers.dev

# --- Optional demo backend (not the default path) ---
# If you still host nexus-server on a HuggingFace Space, set the Space URL here instead of NAS.
# VITE_NEXUS_LITE_DIRECT_URL=https://huggingface.co/spaces/YOUR_USERNAME/YOUR_SPACE_NAME

# Authentication (often injected in CI from GitHub Secrets)
AUTH_SECRET=your-auth-secret-here
OAUTH_GITHUB_CLIENT_ID=your-github-client-id-here
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Cloudflare (often from GitHub Secrets in CI)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# Debug mode (uncomment to enable)
# DEBUG=true
