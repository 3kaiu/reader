# --- Default stack: Cloudflare edge + nexus-server on NAS (GHCR) ---
# Point the reader at your Worker (or same-origin /api). Point direct calls at your Tunnel / NAS URL.

VITE_API_URL=/api
VITE_NEXUS_LITE_DIRECT_URL=https://api.example.com

# Cloudflare (often from GitHub Secrets in CI)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# Debug mode (uncomment to enable)
# DEBUG=true
